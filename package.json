{
  "name": "thomas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Music typesetter: text model -> SVG/PDF",
  "author": {
    "name": "Philipp Naumann",
    "email": "phinau@gmail.com"
  },
  "scripts": {
    "test": "node --test test/",
    "ui": "vite",
    "ui:build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node tools/blanklines.ts && tsc --noEmit",
    "lint:fix": "biome check --write . && node tools/blanklines.ts --fix",
    "format": "biome format --write .",
    "app:build": "node tools/build-app.ts",
    "app": "node tools/build-app.ts && electron .",
    "icon": "node tools/make-icon.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@preact/signals": "^2.11.4",
    "codemirror": "^6.0.2",
    "immer": "^11.2.9",
    "opentype.js": "^2.0.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "main": "out/app/main.js",
  "desktopName": "thomas.desktop"
}
