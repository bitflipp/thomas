{
  "name": "thomas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Music typesetter: text model -> SVG/PDF",
  "author": {
    "name": "Philipp Naumann",
    "email": "phinau@gmail.com"
  },
  "scripts": {
    "test": "node --test test/",
    "ui": "vite",
    "ui:build": "vite build",
    "lint": "biome check . && node tools/blanklines.ts",
    "lint:fix": "biome check --write . && node tools/blanklines.ts --fix",
    "format": "biome format --write .",
    "app:build": "node tools/build-app.ts",
    "app": "node tools/build-app.ts && electron .",
    "app:dev": "node tools/build-app.ts main && THOMAS_DEV_URL=http://localhost:5173 electron .",
    "app:dist": "node tools/build-app.ts && electron-builder",
    "icon": "node tools/make-icon.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@preact/signals": "^2.11.4",
    "codemirror": "^6.0.2",
    "immer": "^11.2.9",
    "opentype.js": "^2.0.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5"
  },
  "main": "out/app/main.js",
  "build": {
    "appId": "org.thomas.editor",
    "productName": "Thomas",
    "files": [
      "out/app/**",
      "out/ui/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "out/dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "syncDesktopName": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "nsis"
    }
  },
  "desktopName": "thomas.desktop"
}
